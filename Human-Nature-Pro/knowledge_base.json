      ]
    },
    {
      "id": "commitment_uncertainty",
      "name": "具体承诺尚未形成",
      "signals": [
        "再看看",
        "以后再定",
        "到时候看",
        "不确定"
      ],
      "counter_signals": [
        "我确认",
        "周三三点",
        "我负责"
      ],
      "questions": [
